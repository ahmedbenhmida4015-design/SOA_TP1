<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="DevPlatform">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Projets">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Projet" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Nom" type="xs:string"/>
                                        <xs:element name="Statut" type="xs:string"/>
                                        <xs:element name="Equipe">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="Developpeur" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="Nom" type="xs:string"/>
                                                                <xs:element name="Email" type="xs:string"/>
                                                            </xs:sequence>
                                                            <xs:attribute name="id" type="xs:string" use="required"/>
                                                            <xs:attribute name="role" type="xs:string" use="required"/>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="Taches">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="Tache" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="Titre" type="xs:string"/>
                                                                <xs:element name="TempsEstime" type="xs:int"/>
                                                                <xs:element name="Etat" type="xs:string"/>
                                                            </xs:sequence>
                                                            <xs:attribute name="id" type="xs:string" use="required"/>
                                                            <xs:attribute name="priorite" type="xs:string" use="required"/>
                                                            <xs:attribute name="type" type="xs:string" use="required"/>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:string" use="required"/>
                                    <xs:attribute name="lang" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="organisation" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>